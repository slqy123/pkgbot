# Based on the AUR fatrace package by Markus Weimar and Frank Phillips.
pkgname=fatrace
pkgver=0.20.0
pkgrel=2
pkgdesc='Reports file access events from running processes.'
arch=('x86_64' 'aarch64' 'armv6l')
url='https://github.com/martinpitt/fatrace'
license=('GPL-3.0-or-later')
depends=('python' 'powertop')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz"
        'current-mount-event-fd.patch')
sha256sums=('242d17dbb7695b1011d97bd856f0756043e6ad73470d38aa0ae69a1df7a490eb'
            'f26fddafcbf5e17681c34c031ff4bb40177bd6fa3c429a3312ff0a64eab5917e')

prepare() {
    cd "$pkgname-$pkgver"
    patch -Np1 --fuzz=0 -i "$srcdir/current-mount-event-fd.patch"
}

build() {
    make -C "$pkgname-$pkgver" fatrace
}

package() {
    make -C "$pkgname-$pkgver" PREFIX=/usr DESTDIR="$pkgdir" install
    mv "$pkgdir/usr/sbin" "$pkgdir/usr/bin"
}
